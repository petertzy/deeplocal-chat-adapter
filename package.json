{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "deeplocal-chat-adapter",
  "displayName": "deeplocal-chat-adapter",
  "description": "Connect DeepLocal OpenAI-compatible models to VS Code.",
  "version": "0.1.0",
  "publisher": "petertzy",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/petertzy/deeplocal-chat-adapter.git"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "deeplocal",
    "local llm",
    "openai compatible"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:deeplocal-chat-adapter.refreshModels",
    "onCommand:deeplocal-chat-adapter.checkConnection",
    "onCommand:deeplocal-chat-adapter.openSettings",
    "onCommand:deeplocal-chat-adapter.open",
    "onCommand:deeplocal-chat-adapter.newSession",
    "onView:deeplocal-chat-adapter.view"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "deeplocal-chat-adapter",
        "displayName": "DeepLocal / OpenAI-compatible",
        "managementCommand": "deeplocal-chat-adapter.openSettings"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deeplocal-chat-adapter-sidebar",
          "title": "DeepLocal",
          "icon": "resources/deeplocal.svg"
        }
      ]
    },
    "views": {
      "deeplocal-chat-adapter-sidebar": [
        {
          "id": "deeplocal-chat-adapter.view",
          "name": "deeplocal-chat-adapter",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "deeplocal-chat-adapter",
      "properties": {
        "deeplocal.apiMode": {
          "type": "string",
          "enum": [
            "chat-completions",
            "responses"
          ],
          "default": "chat-completions",
          "description": "Local API protocol. Select responses only when the service supports the Responses API."
        },
        "deeplocal.remote.apiMode": {
          "type": "string",
          "enum": [
            "chat-completions",
            "responses"
          ],
          "default": "chat-completions",
          "description": "Remote API protocol. Responses enables provider reasoning summaries and requires a compatible endpoint/model."
        },
        "deeplocal.reasoningSummary": {
          "type": "string",
          "enum": [
            "auto",
            "off"
          ],
          "default": "auto",
          "description": "Request reasoning summaries in Responses mode. Turn off for models without summary support."
        },
        "deeplocal.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:14567/v1",
          "description": "DeepLocal OpenAI-compatible API base URL."
        },
        "deeplocal.backend": {
          "type": "string",
          "enum": [
            "local",
            "remote"
          ],
          "enumDescriptions": [
            "Use the local DeepLocal service.",
            "Use the configured remote OpenAI-compatible API. Remote calls may incur provider charges."
          ],
          "default": "local",
          "scope": "application",
          "description": "Select which service the DeepLocal / OpenAI-compatible provider uses."
        },
        "deeplocal.remote.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "Remote OpenAI-compatible API base URL."
        },
        "deeplocal.remote.model": {
          "type": "string",
          "default": "gpt-4.1-mini",
          "description": "Remote model ID. Used directly if model discovery is unavailable."
        },
        "deeplocal.apiKey": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "ignoreSync": true,
          "description": "Optional API key sent as a Bearer token to DeepLocal."
        },
        "deeplocal.requestTimeout": {
          "type": "number",
          "default": 120000,
          "minimum": 1000,
          "description": "Maximum request time in milliseconds."
        },
        "deeplocal.maxInputTokens": {
          "type": "number",
          "default": 131072,
          "minimum": 1024,
          "description": "Advertised maximum input tokens."
        },
        "deeplocal.maxOutputTokens": {
          "type": "number",
          "default": 16384,
          "minimum": 128,
          "description": "Advertised maximum output tokens."
        },
        "deeplocal.enableToolCalling": {
          "type": "boolean",
          "default": true,
          "description": "Expose editor tools to models through OpenAI-compatible tool calling."
        },
        "deeplocal.injectSystemPrompt": {
          "type": "boolean",
          "default": true,
          "description": "Add a compact coding-assistant system prompt before user messages."
        },
        "deeplocal.agentMaxTurns": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "maximum": 1000,
          "description": "Safety limit for tool-use turns in one DeepLocal agent request. The default is high enough that normal tasks do not stop because of this setting."
        },
        "deeplocal.verificationPreferences": {
          "type": "array",
          "scope": "resource",
          "default": [],
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "lint",
              "typecheck",
              "build",
              "test"
            ]
          },
          "description": "Preferred verification categories for Agent tasks. Empty automatically selects available project checks; a non-empty list limits suggested checks to the selected categories."
        },
        "deeplocal.subagents.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Allow normal Agent tasks to delegate scoped read-only research to the selected model. Remote research requests may incur provider charges."
        },
        "deeplocal.subagents.maxConcurrent": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 4,
          "description": "Maximum research subagents running concurrently."
        },
        "deeplocal.subagents.maxTasks": {
          "type": "integer",
          "default": 6,
          "minimum": 1,
          "maximum": 16,
          "description": "Maximum research subagents across all batches in one Agent request."
        },
        "deeplocal.subagents.maxTurns": {
          "type": "integer",
          "default": 8,
          "minimum": 1,
          "maximum": 20,
          "description": "Maximum model turns per research subagent."
        },
        "deeplocal.subagents.timeoutMs": {
          "type": "integer",
          "default": 120000,
          "minimum": 1000,
          "maximum": 600000,
          "description": "Research subagent runtime limit in milliseconds, including approval waits."
        },
        "deeplocal.subagents.batchTimeoutMs": {
          "type": "integer",
          "default": 300000,
          "minimum": 1000,
          "maximum": 900000,
          "description": "Research batch deadline in milliseconds, including queued tasks."
        },
        "deeplocal.subagents.maxOutputTokens": {
          "type": "integer",
          "default": 8192,
          "minimum": 128,
          "maximum": 32768,
          "description": "Cumulative requested generation-token allowance per research subagent. Requests reserve their full output ceiling; this is not an exact billing total."
        },
        "deeplocal.subagents.totalOutputTokens": {
          "type": "integer",
          "default": 32768,
          "minimum": 128,
          "maximum": 131072,
          "description": "Cumulative requested generation-token allowance across all research subagents in one Agent request. Input context is bounded separately."
        },
        "deeplocal.agentMaxRepairIterations": {
          "type": "integer",
          "default": 3,
          "minimum": 0,
          "maximum": 20,
          "description": "Maximum repair cycles after failed or missing verification in an agent request. Each cycle can include multiple edits and checks. Set to 0 to disable automatic repair; verification evidence remains accurate. The overall agentMaxTurns limit still applies."
        },
        "deeplocal.approvalMode": {
          "type": "string",
          "enum": [
            "every",
            "safe",
            "full",
            "ask"
          ],
          "enumDescriptions": [
            "Ask before every agent tool call.",
            "Run safe operations automatically and ask before risky operations.",
            "Allow all agent operations without prompts.",
            "Disable agent operations; the assistant can only answer and explain."
          ],
          "default": "safe",
          "description": "Controls approval and permission behavior for agent tools."
        },
        "deeplocal.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warning",
            "error",
            "off"
          ],
          "default": "info",
          "description": "Controls extension output logging."
        }
      }
    },
    "commands": [
      {
        "command": "deeplocal-chat-adapter.refreshModels",
        "title": "deeplocal-chat-adapter: Refresh Models"
      },
      {
        "command": "deeplocal-chat-adapter.checkConnection",
        "title": "deeplocal-chat-adapter: Check Connection"
      },
      {
        "command": "deeplocal-chat-adapter.testRemoteRequest",
        "title": "deeplocal-chat-adapter: Test Remote API Request"
      },
      {
        "command": "deeplocal-chat-adapter.openSettings",
        "title": "deeplocal-chat-adapter: Open Settings"
      },
      {
        "command": "deeplocal-chat-adapter.open",
        "title": "deeplocal-chat-adapter: Open"
      },
      {
        "command": "deeplocal-chat-adapter.newSession",
        "title": "deeplocal-chat-adapter: New Session"
      },
      {
        "command": "deeplocal-chat-adapter.setRemoteApiKey",
        "title": "deeplocal-chat-adapter: Set Remote API Key"
      },
      {
        "command": "deeplocal-chat-adapter.clearRemoteApiKey",
        "title": "deeplocal-chat-adapter: Clear Remote API Key"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "npm-run-all -p watch:*",
    "watch:bundle": "node esbuild.js --watch",
    "watch:types": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && node esbuild.js --production",
    "package:vsix": "vsce package",
    "install:local": "scripts/install-local.sh",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:webview": "playwright test",
    "check": "npm run check-types && npm run lint && npm test",
    "test:integration": "npm run compile && vscode-test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.3.0",
    "@types/vscode": "^1.104.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.9",
    "eslint": "^8.57.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "koffi": "^2.16.3"
  }
}
