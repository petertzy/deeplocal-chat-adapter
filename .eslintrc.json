{
  "root": true,
  "env": {
    "es2022": true,
    "node": true
  },
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "ignorePatterns": ["dist/", "out/", "node_modules/", ".vscode-test/"],
  "rules": {
    "no-debugger": "error",
    "no-duplicate-imports": "error",
    "no-unreachable": "error"
  }
}
